# Copy to .env - `make env` does it for you with random secrets and free ports.
APP_ENV=production

# The domain customers use (no https://) and the address built from it. Payment callbacks and SMS links use PUBLIC_URL.
APP_DOMAIN=shop.example.com
PUBLIC_URL=https://shop.example.com
LETSENCRYPT_EMAIL=
# Extra domains that redirect to the main one (managed by `make add-domain`)
EXTRA_DOMAINS=

DB_PASSWORD=change-me
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-characters

# First start only: the super admin. Leave the password empty to have one generated and printed in `make logs`.
BOOTSTRAP_ADMIN_USER=admin
BOOTSTRAP_ADMIN_PASSWORD=

# Payment gateway: zarinpal (production) or mock (local testing only; refused when APP_ENV=production)
PAYMENT_GATEWAY=zarinpal
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=false

# SMS (Melli Payamak pattern API). Without SMS_ENABLED=true messages are only logged.
# Pattern IDs are managed in the admin panel (Settings -> SMS patterns), not here.
SMS_ENABLED=false
SMS_USERNAME=
SMS_PASSWORD=

# Old attendance system SECRET_KEY: keeps its kiosk tablets/readers working after import (see docs/MIGRATION.md)
LEGACY_DEVICE_KEY_SECRET=

# Where containers listen on THIS host (picked automatically when free). nginx on the host forwards to WEB_PORT.
WEB_BIND=127.0.0.1
WEB_PORT=8090
DB_HOST_PORT=15432

# Copy every backup to a second server (see `make backup-remote-setup`)
BACKUP_REMOTE=
BACKUP_REMOTE_PORT=

# Use Let's Encrypt's test servers (certificate is NOT trusted) while experimenting
LETSENCRYPT_STAGING=false

# Only for BUILDING images on a PC where proxy.golang.org is blocked (e.g. Iran): a Go module mirror
# GOPROXY=https://package-mirror.liara.ir/repository/go/,direct
